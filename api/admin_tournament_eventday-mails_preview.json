{"subject":"Vandaag is de dag — Blok & Co speelt Volleybal","html":"<!DOCTYPE html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<meta name=\"supported-color-schemes\" content=\"light dark\">\n<title>Vandaag is de dag — Blok &amp; Co speelt Volleybal</title>\n<!--[if !mso]><!-->\n<style>\n@font-face { font-family:'Unbounded'; font-style:normal; font-weight:500 900; src:url(https://sagek17.github.io/fonts/unbounded-var-latin.woff2) format('woff2'); }\n:root { color-scheme: light dark; supported-color-schemes: light dark; }\n@media (max-width:480px) {\n  .sh-rand { padding-left:20px !important; padding-right:20px !important; }\n  .sh-kop { font-size:22px !important; }\n}\n</style>\n<!--<![endif]-->\n</head>\n<body style=\"margin:0; padding:0; background:#06193A; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; -webkit-text-size-adjust:100%;\">\n<div style=\"display:none; max-height:0; overflow:hidden; mso-hide:all;\">Vandaag · Volleybal — JVO Sportdag</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#06193A\" style=\"background:#06193A;\">\n  <tr><td align=\"center\" style=\"padding:24px 12px;\">\n    <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px; width:100%;\">\n\n      <!-- Merkbalk -->\n      <tr><td style=\"padding:4px 8px 20px;\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n          <td valign=\"middle\" width=\"44\" style=\"width:44px;\"><img src=\"https://sagek17.github.io/mail/jvo-logo.png\" width=\"44\" height=\"44\" alt=\"JVO\" style=\"display:block; width:44px; height:44px; border:0; border-radius:22px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:13px; font-weight:800; color:#F6F7FB;\" /></td>\n          <td valign=\"middle\" style=\"padding-left:12px; font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:11px; line-height:1.5; letter-spacing:0.16em; text-transform:uppercase; color:#B9C2D8;\"><b style=\"color:#F6F7FB; font-weight:700;\">Jeugdgroep van Oranje</b><br/>Sportdag</td>\n        </tr></table>\n      </td></tr>\n\n      <!-- Kaartje -->\n      <tr><td bgcolor=\"#FFFFFF\" style=\"background:#FFFFFF; border-radius:18px;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n          <tr><td colspan=\"3\" class=\"sh-rand\" style=\"padding:14px 24px 12px 32px;\">\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n              <td valign=\"middle\" style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:11px; line-height:1.5; font-weight:700; letter-spacing:0.16em; text-transform:uppercase; color:#C4382E;\">Vandaag · Volleybal</td>\n              <td valign=\"middle\" align=\"right\" width=\"58\" style=\"width:58px;\"><img src=\"https://sagek17.github.io/mail/sport-volleybal.png\" width=\"46\" height=\"46\" alt=\"\" style=\"display:block; width:46px; height:46px; border:0; margin-left:12px;\" /></td>\n            </tr></table>\n          </td></tr>\n          <tr>\n            <td width=\"9\" bgcolor=\"#06193A\" style=\"width:9px; height:18px; background:#06193A; border-radius:0 9px 9px 0; font-size:0; line-height:0;\">&nbsp;</td>\n            <td style=\"padding:0 12px; font-size:0; line-height:0;\"><div style=\"height:0; border-top:2px dashed #AEB5C6; font-size:0; line-height:0;\">&nbsp;</div></td>\n            <td width=\"9\" bgcolor=\"#06193A\" style=\"width:9px; height:18px; background:#06193A; border-radius:9px 0 0 9px; font-size:0; line-height:0;\">&nbsp;</td>\n          </tr>\n          <tr><td colspan=\"3\" class=\"sh-rand\" style=\"padding:22px 32px 32px;\">\n            <h1 class=\"sh-kop\" style=\"margin:0 0 20px; font-family:'Unbounded','Arial Rounded MT Bold','Arial Black','Helvetica Neue',Arial,sans-serif; font-size:26px; font-weight:900; line-height:1.12; letter-spacing:-0.02em; color:#06193A; overflow-wrap:break-word;\">Vandaag is de dag, Speler<span style=\"color:#FF6B1A;\">.</span></h1>\n            <div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:15px; line-height:1.6; color:#06193A;\">\n              \n      <p style=\"margin:0 0 14px;\">Vandaag speelt team <b style=\"color:#06193A; font-weight:600;\">Blok &amp; Co</b> <b style=\"color:#06193A; font-weight:600;\">Volleybal</b> (Poule A). Hieronder alles wat je vandaag nodig hebt — kort en compleet.</p>\n\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:18px 0; background:#FDF0EE; border:1px solid #E9B4AF; border-radius:8px;\">\n        <tr><td style=\"padding:16px 18px;\">\n          <div style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:#C4382E; margin-bottom:6px;\">Eerst dit — wees op tijd</div>\n          <div style=\"font-size:15px; color:#06193A; line-height:1.55;\">Zorg dat je team <b style=\"color:#06193A; font-weight:600;\">uiterlijk om 08:25 aanwezig</b> is. Volleybal begint om <b style=\"color:#06193A; font-weight:600;\">09:25</b>. Zo is er tijd om in te checken en warm te worden, en kunnen we op tijd beginnen. <b style=\"color:#06193A; font-weight:600;\">Jullie team-QR zit (nogmaals) in de bijlage</b> — of gebruik de check-in-code hieronder.</div>\n        </td></tr>\n      </table>\n\n      \n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:18px 0; background:#FFF4EC; border:1px solid #FF9A5C; border-radius:10px;\">\n        <tr><td style=\"padding:18px 18px 16px;\">\n          <div style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:#C4382E; margin-bottom:6px;\">Vandaag onmisbaar: de live-app</div>\n          <div style=\"font-size:14px; color:#06193A; line-height:1.6; margin-bottom:12px;\">De <b style=\"color:#06193A; font-weight:600;\">definitieve poules, tegenstanders, tijden en speelplekken</b> zie je vandaag alleen in de app — het schema kan op de dag zelf nog schuiven, en de app schuift live mee. Je ziet er ook <b style=\"color:#06193A; font-weight:600;\">jullie volgende wedstrijd</b>, alle live standen en de weg naar de finale.</div>\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0;\"><tr><td align=\"center\" bgcolor=\"#FF6B1A\" style=\"background:#FF6B1A; border-radius:999px; mso-padding-alt:13px 24px;\"><a href=\"https://sagek17.github.io/sporten?sport=3&amp;volg=11\" style=\"display:inline-block; padding:13px 24px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:14px; line-height:1.25; font-weight:700; color:#06193A; text-decoration:none; border-radius:999px;\">Open de live-app — jouw team staat al klaar →</a></td></tr></table>\n          <p style=\"margin:12px 0 0; font-size:12px; line-height:1.5; color:#4A4F72;\">De app opent Volleybal en volgt team Blok &amp; Co automatisch. Tip: zet 'm op je beginscherm en zet meldingen aan.</p>\n        </td></tr>\n      </table>\n\n      \n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:18px 0; background:#F3F5FA; border:1px solid #FFC9A6; border-radius:8px;\">\n        <tr><td style=\"padding:14px 18px;\">\n          <div style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:#C4382E; margin-bottom:6px;\">Jullie sport</div>\n          <div style=\"font-size:16px; font-weight:600; color:#06193A; line-height:1.4;\">Volleybal · 4 tegen 4 · start 09:25</div>\n          \n        </td></tr>\n      </table>\n\n      \n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:18px 0; background:#FFF4EC; border:1px solid #FFC9A6; border-radius:8px;\">\n        <tr><td style=\"padding:16px 18px;\">\n          <div style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:#C4382E; margin-bottom:6px;\">Reserve: jullie check-in-code</div>\n          <div style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:30px; font-weight:700; letter-spacing:0.14em; color:#06193A; margin:2px 0 8px;\">4T9-G77</div>\n          <div style=\"font-size:13px; color:#4A4F72; line-height:1.55;\">Scant de QR niet (kapot scherm, fel zonlicht, geen bereik)? Noem deze code bij de check-in — de crew typt 'm in en jullie zijn alsnog binnen.</div>\n        </td></tr>\n      </table>\n\n      \n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:18px 0; background:#F3F5FA; border-radius:8px; border:1px solid #D5DAE8;\">\n  <tr><td style=\"padding:16px 18px;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n      <tr>\n        <td style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:#4A4F72; padding-bottom:4px;\">Wanneer</td>\n        <td style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:#4A4F72; padding-bottom:4px;\">Locatie</td>\n      </tr>\n      <tr>\n        <td valign=\"top\" style=\"padding-right:14px;\">\n          <div style=\"font-family:'Unbounded','Arial Rounded MT Bold','Arial Black','Helvetica Neue',Arial,sans-serif; font-size:18px; font-weight:900; color:#06193A; line-height:1.2; text-transform:none; font-size:15px; line-height:1.25; letter-spacing:-0.01em;\">Zondag 22 november 2026</div>\n          <div style=\"margin-top:4px; font-size:13px; color:#06193A;\">Inloop 08:30 · Start 09:00 · Eind ± 14:00</div>\n        </td>\n        <td valign=\"top\">\n          <div style=\"font-family:'Unbounded','Arial Rounded MT Bold','Arial Black','Helvetica Neue',Arial,sans-serif; font-size:18px; font-weight:900; color:#06193A; line-height:1.2; text-transform:none; font-size:15px; line-height:1.25; letter-spacing:-0.01em;\">Sportcampus Zuiderpark, Den Haag</div>\n          <div style=\"margin-top:4px; font-size:13px; color:#06193A;\">Mr. P. Droogleever Fortuynweg 22, 2533 SR Den Haag</div>\n        </td>\n      </tr>\n    </table>\n  </td></tr>\n</table>\n\n      \n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:18px 0; background:#FFFFFF; border:1px solid #FFC9A6; border-radius:8px;\">\n        <tr><td style=\"padding:16px 18px;\">\n          <div style=\"font-size:13px; font-weight:600; color:#06193A; margin-bottom:6px;\">🔔 Meldingen op je telefoon</div>\n          <p style=\"margin:0 0 12px; font-size:13px; line-height:1.55; color:#4A4F72;\">Krijg een seintje als je team <b style=\"color:#06193A; font-weight:600;\">bijna moet spelen</b>, bij de <b style=\"color:#06193A; font-weight:600;\">start</b> en bij de <b style=\"color:#06193A; font-weight:600;\">uitslag</b>. Eén tik aan — en wanneer je wilt weer uit.</p>\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0;\"><tr><td align=\"center\" bgcolor=\"#FF6B1A\" style=\"background:#FF6B1A; border-radius:999px; mso-padding-alt:12px 22px;\"><a href=\"https://sagek17.github.io/mijn?team=11&amp;push=1#k=voorbeeld\" style=\"display:inline-block; padding:12px 22px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:14px; line-height:1.25; font-weight:700; color:#06193A; text-decoration:none; border-radius:999px;\">Open Mijn team &amp; zet meldingen aan</a></td></tr></table>\n          <p style=\"margin:12px 0 0; font-size:11px; line-height:1.5; color:#4A4F72;\">Geen meldingen nodig? Dan doe je gewoon niks — ze gaan alleen aan als je ze zelf aanzet, en je zet ze altijd weer uit met dezelfde knop.</p>\n        </td></tr>\n      </table>\n\n      \n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:18px 0; background:#FFFFFF; border:1px solid #AEB9D3; border-radius:8px;\">\n        <tr><td style=\"padding:16px 18px;\">\n          <div style=\"font-size:13px; font-weight:600; color:#06193A; margin-bottom:6px;\">📣 Stuur dit door naar je team</div>\n          <p style=\"margin:0 0 12px; font-size:13px; line-height:1.55; color:#4A4F72;\">Wil je dat je teamgenoten óók een seintje krijgen? Stuur ze deze link — ze volgen <b style=\"color:#06193A; font-weight:600;\">Blok &amp; Co</b> dan met één tik en kunnen meldingen aanzetten.</p>\n          <a href=\"https://wa.me/?text=Volg%20Blok%20%26%20Co%20live%20op%20de%20JVO%20Sportdag%20%E2%80%94%20en%20zet%20meldingen%20aan%20voor%20aftrap%2C%20uitslag%20en%20als%20we%20verder%20komen%3A%20https%3A%2F%2Fsagek17.github.io%2Fsporten%3Fsport%3D3%26volg%3D11%26push%3D1\" style=\"display:inline-block; background:#25D366; color:#08230f; text-decoration:none; padding:11px 18px; border-radius:999px; font-size:14px; line-height:1.25; font-weight:700; margin:0 8px 6px 0;\">Deel via WhatsApp</a>\n          <a href=\"https://sagek17.github.io/sporten?sport=3&amp;volg=11&amp;push=1\" style=\"color:#06193A; text-decoration:underline; font-size:13px;\">of open &amp; kopieer de link</a>\n        </td></tr>\n      </table>\n\n      <p style=\"margin:14px 0; font-size:13px; color:#4A4F72;\">Nog even de <a href=\"https://sagek17.github.io/spelregels\" style=\"color:#06193A; text-decoration:underline;\">spelregels</a> doornemen kan geen kwaad. Zet 'm op vandaag — we zien jullie daar! 🧡</p>\n    \n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:18px 0; background:#FFFFFF; border:1px solid #FFC9A6; border-radius:8px;\">\n        <tr><td style=\"padding:16px 18px;\">\n          <div style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:#C4382E; margin-bottom:10px;\">Mijn team</div>\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0;\"><tr><td align=\"center\" bgcolor=\"#FF6B1A\" style=\"background:#FF6B1A; border-radius:999px; mso-padding-alt:12px 22px;\"><a href=\"https://sagek17.github.io/mijn?team=11#k=voorbeeld\" style=\"display:inline-block; padding:12px 22px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:14px; line-height:1.25; font-weight:700; color:#06193A; text-decoration:none; border-radius:999px;\">Open Mijn team</a></td></tr></table>\n          <p style=\"margin:12px 0 0; font-size:13px; line-height:1.55; color:#4A4F72;\">Status, QR en je wedstrijden op één plek. Bewaar deze mail: de knop is je sleutel.</p>\n          <p style=\"margin:12px 0 0; padding-top:12px; border-top:1px solid #FFC9A6; font-size:13px; line-height:1.55; color:#4A4F72;\">Teamcode: <b style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:15px; letter-spacing:0.08em; color:#06193A; font-weight:700; white-space:nowrap;\">PV8H-WNR4</b><br/>Hiermee kijken teamgenoten mee. Typ hem op <a href=\"https://sagek17.github.io/mijn\" style=\"color:#4A4F72; text-decoration:underline;\">sagek17.github.io/mijn</a>.</p>\n        </td></tr>\n      </table>\n            </div>\n          </td></tr>\n        </table>\n      </td></tr>\n\n      <tr><td align=\"center\" style=\"padding:24px 0 8px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"margin:0;\"><tr><td align=\"center\" bgcolor=\"#FF6B1A\" style=\"background:#FF6B1A; border-radius:999px; mso-padding-alt:16px 32px;\"><a href=\"https://sagek17.github.io/sporten?sport=3&amp;volg=11\" style=\"display:inline-block; padding:16px 32px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:16px; line-height:1.25; font-weight:700; color:#06193A; text-decoration:none; border-radius:999px;\">Open de live-app →</a></td></tr></table></td></tr>\n\n      \n\n      <!-- Afzender -->\n      <tr><td style=\"padding:28px 12px 0;\"><div style=\"height:0; border-top:1px solid #2A3B60; font-size:0; line-height:0;\">&nbsp;</div></td></tr>\n      <tr><td align=\"center\" style=\"padding:22px 12px 8px; text-align:center;\">\n        <div style=\"font-family:'Unbounded','Arial Rounded MT Bold','Arial Black','Helvetica Neue',Arial,sans-serif; font-size:16px; font-weight:900; letter-spacing:-0.01em; color:#F6F7FB;\">— JVO</div>\n        <div style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:10.5px; letter-spacing:0.16em; text-transform:uppercase; color:#B9C2D8; margin-top:6px;\">Jeugdgroep van Oranje</div>\n        <div style=\"margin-top:10px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:12px;\"><a href=\"https://www.jvonl.nl\" style=\"color:#F6F7FB; text-decoration:underline;\">jvonl.nl</a></div>\n      </td></tr>\n\n      <tr><td style=\"padding:14px 12px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:11px; color:#B9C2D8; text-align:center; line-height:1.5;\">\n        Je ontvangt deze mail omdat je je hebt aangemeld voor de JVO Sportdag.<br/>\n        Vragen? Beantwoord deze mail of stuur naar <a href=\"mailto:contact@example.org\" style=\"color:#B9C2D8; text-decoration:underline;\">contact@example.org</a>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>\n</body>\n</html>","text":"Hoi Speler,\n\nVANDAAG IS DE DAG — team \"Blok & Co\" speelt Volleybal (Poule A)!\n\nEERST DIT: Zorg dat je team uiterlijk om 08:25 aanwezig is. Volleybal begint om 09:25. Zo is er tijd om in te checken en warm te worden, en kunnen we op tijd beginnen.\nJullie team-QR zit (nogmaals) in de bijlage; de check-in-code staat hieronder.\n\nDE LIVE-APP IS VANDAAG ONMISBAAR\nDe definitieve poules, tegenstanders, tijden en speelplekken zie je alleen in de app —\nhet schema kan vandaag nog schuiven en de app schuift live mee. Ook: jullie\nvolgende wedstrijd, live standen en de weg naar de finale.\nDe link (volgt Blok & Co automatisch):\nhttps://sagek17.github.io/sporten?sport=3&volg=11\n\nSport: Volleybal · 4 tegen 4 · start 09:25\n\nCheck-in-code (reserve, als de QR niet scant): 4T9-G77 — noem 'm bij de check-in.\n\nLocatie: Sportcampus Zuiderpark, Den Haag (Mr. P. Droogleever Fortuynweg 22, 2533 SR Den Haag)\n\nMeldingen op je telefoon: een seintje als je team bijna moet spelen, bij de start en bij de uitslag. Zet aan (en altijd weer uit) via:\nhttps://sagek17.github.io/mijn?team=11&push=1#k=voorbeeld\n\nStuur dit door naar je team — dan volgen zij Blok & Co ook en kunnen ze meldingen aanzetten:\nhttps://sagek17.github.io/sporten?sport=3&volg=11&push=1\n\nSpelregels: https://sagek17.github.io/spelregels\nZet 'm op vandaag — we zien jullie daar!\n\nOpen Mijn team: status, QR en je wedstrijden op één plek.\nhttps://sagek17.github.io/mijn?team=11#k=voorbeeld\nBewaar deze mail: de link is je sleutel.\nTeamcode: PV8H-WNR4\nHiermee kijken teamgenoten mee. Typ hem op https://sagek17.github.io/mijn\n\n— JVO\nJeugdgroep van Oranje · jvonl.nl\n","recipients":40,"visitor_subject":"Vandaag is de dag — JVO Sportdag","visitor_html":"<!DOCTYPE html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<meta name=\"supported-color-schemes\" content=\"light dark\">\n<title>Vandaag is de dag — JVO Sportdag</title>\n<!--[if !mso]><!-->\n<style>\n@font-face { font-family:'Unbounded'; font-style:normal; font-weight:500 900; src:url(https://sagek17.github.io/fonts/unbounded-var-latin.woff2) format('woff2'); }\n:root { color-scheme: light dark; supported-color-schemes: light dark; }\n@media (max-width:480px) {\n  .sh-rand { padding-left:20px !important; padding-right:20px !important; }\n  .sh-kop { font-size:22px !important; }\n}\n</style>\n<!--<![endif]-->\n</head>\n<body style=\"margin:0; padding:0; background:#06193A; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; -webkit-text-size-adjust:100%;\">\n<div style=\"display:none; max-height:0; overflow:hidden; mso-hide:all;\">Vandaag · JVO Sportdag — JVO Sportdag</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#06193A\" style=\"background:#06193A;\">\n  <tr><td align=\"center\" style=\"padding:24px 12px;\">\n    <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px; width:100%;\">\n\n      <!-- Merkbalk -->\n      <tr><td style=\"padding:4px 8px 20px;\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n          <td valign=\"middle\" width=\"44\" style=\"width:44px;\"><img src=\"https://sagek17.github.io/mail/jvo-logo.png\" width=\"44\" height=\"44\" alt=\"JVO\" style=\"display:block; width:44px; height:44px; border:0; border-radius:22px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:13px; font-weight:800; color:#F6F7FB;\" /></td>\n          <td valign=\"middle\" style=\"padding-left:12px; font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:11px; line-height:1.5; letter-spacing:0.16em; text-transform:uppercase; color:#B9C2D8;\"><b style=\"color:#F6F7FB; font-weight:700;\">Jeugdgroep van Oranje</b><br/>Sportdag</td>\n        </tr></table>\n      </td></tr>\n\n      <!-- Kaartje -->\n      <tr><td bgcolor=\"#FFFFFF\" style=\"background:#FFFFFF; border-radius:18px;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n          <tr><td colspan=\"3\" class=\"sh-rand\" style=\"padding:14px 24px 12px 32px;\">\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr>\n              <td valign=\"middle\" style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:11px; line-height:1.5; font-weight:700; letter-spacing:0.16em; text-transform:uppercase; color:#C4382E;\">Vandaag · JVO Sportdag</td>\n              <td valign=\"middle\" align=\"right\" width=\"58\" style=\"width:58px;\"><img src=\"https://sagek17.github.io/mail/sport-beker.png\" width=\"46\" height=\"46\" alt=\"\" style=\"display:block; width:46px; height:46px; border:0; margin-left:12px;\" /></td>\n            </tr></table>\n          </td></tr>\n          <tr>\n            <td width=\"9\" bgcolor=\"#06193A\" style=\"width:9px; height:18px; background:#06193A; border-radius:0 9px 9px 0; font-size:0; line-height:0;\">&nbsp;</td>\n            <td style=\"padding:0 12px; font-size:0; line-height:0;\"><div style=\"height:0; border-top:2px dashed #AEB5C6; font-size:0; line-height:0;\">&nbsp;</div></td>\n            <td width=\"9\" bgcolor=\"#06193A\" style=\"width:9px; height:18px; background:#06193A; border-radius:9px 0 0 9px; font-size:0; line-height:0;\">&nbsp;</td>\n          </tr>\n          <tr><td colspan=\"3\" class=\"sh-rand\" style=\"padding:22px 32px 32px;\">\n            <h1 class=\"sh-kop\" style=\"margin:0 0 20px; font-family:'Unbounded','Arial Rounded MT Bold','Arial Black','Helvetica Neue',Arial,sans-serif; font-size:26px; font-weight:900; line-height:1.12; letter-spacing:-0.02em; color:#06193A; overflow-wrap:break-word;\">Vandaag is de dag, Speler<span style=\"color:#FF6B1A;\">.</span></h1>\n            <div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:15px; line-height:1.6; color:#06193A;\">\n              \n      <p style=\"margin:0 0 14px;\">Vandaag is het zover: de <b style=\"color:#06193A; font-weight:600;\">JVO Sportdag</b>! Loop gewoon binnen — geen check-in nodig.</p>\n\n      \n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:18px 0; background:#FFF4EC; border:1px solid #FF9A5C; border-radius:10px;\">\n        <tr><td style=\"padding:18px 18px 16px;\">\n          <div style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:#C4382E; margin-bottom:6px;\">Volg het toernooi live in de app</div>\n          <div style=\"font-size:14px; color:#06193A; line-height:1.6; margin-bottom:12px;\">De <b style=\"color:#06193A; font-weight:600;\">definitieve poules, het wedstrijdschema, alle standen en de knock-out</b> zie je vandaag live in de app — bijgewerkt terwijl er gespeeld wordt. Kies een favoriet team om aan te moedigen en zet <b style=\"color:#06193A; font-weight:600;\">meldingen</b> aan voor de start, uitslag en als ze verder komen.</div>\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0;\"><tr><td align=\"center\" bgcolor=\"#FF6B1A\" style=\"background:#FF6B1A; border-radius:999px; mso-padding-alt:13px 24px;\"><a href=\"https://sagek17.github.io/sporten\" style=\"display:inline-block; padding:13px 24px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:14px; line-height:1.25; font-weight:700; color:#06193A; text-decoration:none; border-radius:999px;\">Open het live toernooi →</a></td></tr></table>\n        </td></tr>\n      </table>\n\n      \n    <div style=\"font-size:13px; font-weight:600; color:#06193A; margin:20px 0 8px;\">Het dagprogramma</div>\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 0 4px; background:#F3F5FA; border:1px solid #D5DAE8; border-radius:10px; overflow:hidden;\">\n      \n    <tr>\n      <td valign=\"top\" style=\"padding:11px 14px; border-bottom:1px solid #D5DAE8; font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:13px; letter-spacing:0.04em; color:#06193A; white-space:nowrap; width:76px;\">08:30</td>\n      <td style=\"padding:11px 14px; border-bottom:1px solid #D5DAE8;\">\n        <div style=\"font-size:14px; color:#06193A; font-weight:600;\">Deuren open</div>\n        <div style=\"font-size:13px; color:#4A4F72; margin-top:2px; line-height:1.5;\">Inloop voor bezoekers en publiek.</div>\n      </td>\n    </tr>\n    <tr>\n      <td valign=\"top\" style=\"padding:11px 14px; border-bottom:1px solid #D5DAE8; font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:13px; letter-spacing:0.04em; color:#06193A; white-space:nowrap; width:76px;\">09:00</td>\n      <td style=\"padding:11px 14px; border-bottom:1px solid #D5DAE8;\">\n        <div style=\"font-size:14px; color:#06193A; font-weight:600;\">Aftrap toernooi</div>\n        <div style=\"font-size:13px; color:#4A4F72; margin-top:2px; line-height:1.5;\">De poulefase begint.</div>\n      </td>\n    </tr>\n    <tr>\n      <td valign=\"top\" style=\"padding:11px 14px; border-bottom:1px solid #D5DAE8; font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:13px; letter-spacing:0.04em; color:#06193A; white-space:nowrap; width:76px;\">Daarna</td>\n      <td style=\"padding:11px 14px; border-bottom:1px solid #D5DAE8;\">\n        <div style=\"font-size:14px; color:#06193A; font-weight:600;\">Knock-out</div>\n        <div style=\"font-size:13px; color:#4A4F72; margin-top:2px; line-height:1.5;\">Play-offs, kwart- en halve finales — op weg naar de finale.</div>\n      </td>\n    </tr>\n    <tr>\n      <td valign=\"top\" style=\"padding:11px 14px; border-bottom:1px solid #D5DAE8; font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:13px; letter-spacing:0.04em; color:#06193A; white-space:nowrap; width:76px;\">Slotstuk</td>\n      <td style=\"padding:11px 14px; border-bottom:1px solid #D5DAE8;\">\n        <div style=\"font-size:14px; color:#06193A; font-weight:600;\">Finale &amp; prijsuitreiking</div>\n        <div style=\"font-size:13px; color:#4A4F72; margin-top:2px; line-height:1.5;\">De finale, en daarna de prijsuitreiking.</div>\n      </td>\n    </tr>\n    <tr>\n      <td valign=\"top\" style=\"padding:11px 14px; border-bottom:1px solid #D5DAE8; font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:13px; letter-spacing:0.04em; color:#06193A; white-space:nowrap; width:76px;\">± 14:00</td>\n      <td style=\"padding:11px 14px; border-bottom:1px solid #D5DAE8;\">\n        <div style=\"font-size:14px; color:#06193A; font-weight:600;\">Einde</div>\n        <div style=\"font-size:13px; color:#4A4F72; margin-top:2px; line-height:1.5;\">Afsluiting van de JVO Sportdag. Het toernooi kan uitlopen — de app toont live de verwachte eindtijd.</div>\n      </td>\n    </tr>\n    </table>\n\n      \n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:18px 0; background:#F3F5FA; border-radius:8px; border:1px solid #D5DAE8;\">\n  <tr><td style=\"padding:16px 18px;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n      <tr>\n        <td style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:#4A4F72; padding-bottom:4px;\">Wanneer</td>\n        <td style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:#4A4F72; padding-bottom:4px;\">Locatie</td>\n      </tr>\n      <tr>\n        <td valign=\"top\" style=\"padding-right:14px;\">\n          <div style=\"font-family:'Unbounded','Arial Rounded MT Bold','Arial Black','Helvetica Neue',Arial,sans-serif; font-size:18px; font-weight:900; color:#06193A; line-height:1.2; text-transform:none; font-size:15px; line-height:1.25; letter-spacing:-0.01em;\">Zondag 22 november 2026</div>\n          <div style=\"margin-top:4px; font-size:13px; color:#06193A;\">Inloop 08:30 · Start 09:00 · Eind ± 14:00</div>\n        </td>\n        <td valign=\"top\">\n          <div style=\"font-family:'Unbounded','Arial Rounded MT Bold','Arial Black','Helvetica Neue',Arial,sans-serif; font-size:18px; font-weight:900; color:#06193A; line-height:1.2; text-transform:none; font-size:15px; line-height:1.25; letter-spacing:-0.01em;\">Sportcampus Zuiderpark, Den Haag</div>\n          <div style=\"margin-top:4px; font-size:13px; color:#06193A;\">Mr. P. Droogleever Fortuynweg 22, 2533 SR Den Haag</div>\n        </td>\n      </tr>\n    </table>\n  </td></tr>\n</table>\n\n      \n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:18px 0; background:#FFFFFF; border:1px solid #FFC9A6; border-radius:8px;\">\n        <tr><td style=\"padding:16px 18px;\">\n          <div style=\"font-size:13px; font-weight:600; color:#06193A; margin-bottom:6px;\">🔔 Moedig een team aan</div>\n          <p style=\"margin:0 0 12px; font-size:13px; line-height:1.55; color:#4A4F72;\">Volg één of meer teams en krijg een seintje bij <b style=\"color:#06193A; font-weight:600;\">de start</b>, de <b style=\"color:#06193A; font-weight:600;\">uitslag</b> en als ze <b style=\"color:#06193A; font-weight:600;\">verder komen</b>. Eén tik aan — en wanneer je wilt weer uit.</p>\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0;\"><tr><td align=\"center\" bgcolor=\"#FF6B1A\" style=\"background:#FF6B1A; border-radius:999px; mso-padding-alt:12px 22px;\"><a href=\"https://sagek17.github.io/sporten?push=1\" style=\"display:inline-block; padding:12px 22px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:14px; line-height:1.25; font-weight:700; color:#06193A; text-decoration:none; border-radius:999px;\">Kies een team &amp; zet meldingen aan</a></td></tr></table>\n          <p style=\"margin:12px 0 0; font-size:11px; line-height:1.5; color:#4A4F72;\">Geen meldingen nodig? Dan doe je gewoon niks — ze gaan alleen aan als je ze zelf aanzet, en je zet ze altijd weer uit met dezelfde knop.</p>\n        </td></tr>\n      </table>\n\n      \n      <p style=\"margin:18px 0 0;\">Tot vandaag! 🧡</p>\n    \n            </div>\n          </td></tr>\n        </table>\n      </td></tr>\n\n      <tr><td align=\"center\" style=\"padding:24px 0 8px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"margin:0;\"><tr><td align=\"center\" bgcolor=\"#FF6B1A\" style=\"background:#FF6B1A; border-radius:999px; mso-padding-alt:16px 32px;\"><a href=\"https://sagek17.github.io/sporten\" style=\"display:inline-block; padding:16px 32px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:16px; line-height:1.25; font-weight:700; color:#06193A; text-decoration:none; border-radius:999px;\">Open het live toernooi →</a></td></tr></table></td></tr>\n\n      \n\n      <!-- Afzender -->\n      <tr><td style=\"padding:28px 12px 0;\"><div style=\"height:0; border-top:1px solid #2A3B60; font-size:0; line-height:0;\">&nbsp;</div></td></tr>\n      <tr><td align=\"center\" style=\"padding:22px 12px 8px; text-align:center;\">\n        <div style=\"font-family:'Unbounded','Arial Rounded MT Bold','Arial Black','Helvetica Neue',Arial,sans-serif; font-size:16px; font-weight:900; letter-spacing:-0.01em; color:#F6F7FB;\">— JVO</div>\n        <div style=\"font-family:ui-monospace,'SF Mono',Menlo,Consolas,'Courier New',monospace; font-size:10.5px; letter-spacing:0.16em; text-transform:uppercase; color:#B9C2D8; margin-top:6px;\">Jeugdgroep van Oranje</div>\n        <div style=\"margin-top:10px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:12px;\"><a href=\"https://www.jvonl.nl\" style=\"color:#F6F7FB; text-decoration:underline;\">jvonl.nl</a></div>\n      </td></tr>\n\n      <tr><td style=\"padding:14px 12px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:11px; color:#B9C2D8; text-align:center; line-height:1.5;\">\n        Je ontvangt deze mail omdat je je hebt aangemeld voor de JVO Sportdag.<br/>\n        Vragen? Beantwoord deze mail of stuur naar <a href=\"mailto:contact@example.org\" style=\"color:#B9C2D8; text-decoration:underline;\">contact@example.org</a>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>\n</body>\n</html>","visitor_recipients":2}